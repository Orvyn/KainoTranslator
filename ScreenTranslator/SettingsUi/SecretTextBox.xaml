<UserControl x:Class="ScreenTranslator.SettingsUi.SecretTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- API key field: masked with asterisks by default (PasswordBox also refuses Ctrl+C / Ctrl+X
         while masked, so the key can't be copied out of it by accident), with an eye button that
         swaps in a plain TextBox to reveal it. Exposes a plain Text property, so the settings
         window reads and writes it exactly like the TextBox it replaced. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <PasswordBox x:Name="Masked" Grid.Column="0" PasswordChar="*" PasswordChanged="OnMaskedChanged"/>
        <TextBox x:Name="Plain" Grid.Column="0" Visibility="Collapsed" TextChanged="OnPlainChanged"/>
        <ToggleButton x:Name="EyeButton" Grid.Column="1" Margin="6,0,0,0"
                      Style="{StaticResource EyeToggleButton}"
                      Checked="OnEyeToggled" Unchecked="OnEyeToggled"/>
    </Grid>
</UserControl>
