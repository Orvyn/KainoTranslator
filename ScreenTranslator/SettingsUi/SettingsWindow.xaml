<Window x:Class="ScreenTranslator.SettingsUi.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KainoTranslator - Настройки"
        Width="700" Height="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="16">

        <!-- Header -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <TextBlock Text="🌐" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="KainoTranslator" Style="{StaticResource H1}"/>
                    <TextBlock Text="Перевод текста с экрана в реальном времени" Style="{StaticResource Hint}" Margin="0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                <Button x:Name="SelectRegionButton" Style="{StaticResource IconSquareButton}" Margin="0,0,8,0"
                        Click="OnSelectRegionClick" ToolTip="Выбрать область экрана для перевода">
                    <TextBlock Text="⛶"/>
                </Button>
                <Button x:Name="ToggleButton" Style="{StaticResource IconSquareButton}"
                        Click="OnToggleClick" ToolTip="Включить перевод">
                    <TextBlock x:Name="ToggleButtonIcon" Text="▶"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="Закрыть" Width="100" Height="32" Style="{StaticResource SecondaryButton}" Click="OnCloseClick" Margin="0,0,8,0"/>
            <Button Content="Сохранить" Width="120" Height="32" Style="{StaticResource PrimaryButton}" Click="OnSaveClick"/>
        </StackPanel>

        <TabControl BorderThickness="0" Background="Transparent">

            <!-- ===================== ПЕРЕВОД (OCR + переводчик объединены) ===================== -->
            <TabItem Header="🌍 Перевод">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,12,4,4">

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Способ распознавания текста (OCR)" Style="{StaticResource H2}"/>
                            <ComboBox x:Name="OcrEngineCombo" Margin="0,0,0,4" SelectionChanged="OnOcrEngineChanged"/>
                            <TextBlock x:Name="OcrEngineHint" Style="{StaticResource Hint}"/>
                            <TextBlock x:Name="WindowsOcrLinkBlock">
                                <Hyperlink NavigateUri="ms-settings:regionlanguage" RequestNavigate="LinkOpener_OnRequestNavigate">Открыть языковые настройки Windows</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Язык, который нужно распознавать" Style="{StaticResource H2}"/>
                            <ComboBox x:Name="SourceLanguageCombo"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Сервис перевода" Style="{StaticResource H2}"/>
                            <ComboBox x:Name="TranslatorCombo" Margin="0,0,0,4" SelectionChanged="OnTranslatorChanged"/>
                            <TextBlock x:Name="TranslatorHint" Style="{StaticResource Hint}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Язык перевода" Style="{StaticResource H2}"/>
                            <ComboBox x:Name="TargetLanguageCombo"/>
                        </StackPanel>
                    </Border>

                    <!-- DeepL -->
                    <Border x:Name="DeepLCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Ключ DeepL" Style="{StaticResource H2}"/>
                            <TextBlock Margin="0,0,0,6">
                                <Run Text="Получить бесплатный ключ: "/>
                                <Hyperlink NavigateUri="https://www.deepl.com/pro-api" RequestNavigate="LinkOpener_OnRequestNavigate">deepl.com/pro-api</Hyperlink>
                            </TextBlock>
                            <TextBlock Text="API-ключ" Style="{StaticResource Label}"/>
                            <TextBox x:Name="DeepLKeyBox" Margin="0,0,0,6"/>
                            <CheckBox x:Name="DeepLProCheck">
                                <TextBlock Text="У меня платный ключ Pro (использовать api.deepl.com вместо бесплатного api-free.deepl.com)" TextWrapping="Wrap"/>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Google -->
                    <Border x:Name="GoogleCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Google Translate" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                       Text="Работает сразу, без ключа (бесплатный способ). Ключ нужен только для гарантированной стабильной работы без ограничений — получить его можно в Google Cloud Console."/>
                            <TextBlock Margin="0,0,0,6">
                                <Hyperlink NavigateUri="https://cloud.google.com/translate/docs/setup" RequestNavigate="LinkOpener_OnRequestNavigate">Получить ключ Cloud Translation API (необязательно)</Hyperlink>
                            </TextBlock>
                            <TextBlock Text="API-ключ (необязательно)" Style="{StaticResource Label}"/>
                            <TextBox x:Name="GoogleKeyBox"/>
                        </StackPanel>
                    </Border>

                    <!-- Yandex -->
                    <Border x:Name="YandexCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Yandex Translate" Style="{StaticResource H2}"/>
                            <TextBlock Margin="0,0,0,6">
                                <Run Text="Получить ключ и Folder ID: "/>
                                <Hyperlink NavigateUri="https://yandex.cloud/en/docs/translate/quickstart" RequestNavigate="LinkOpener_OnRequestNavigate">yandex.cloud (Translate quickstart)</Hyperlink>
                            </TextBlock>
                            <TextBlock Text="API-ключ" Style="{StaticResource Label}"/>
                            <TextBox x:Name="YandexKeyBox" Margin="0,0,0,6"/>
                            <TextBlock Text="Folder ID" Style="{StaticResource Label}"/>
                            <TextBox x:Name="YandexFolderBox"/>
                        </StackPanel>
                    </Border>

                    <!-- Papago -->
                    <Border x:Name="PapagoCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Papago (Naver Cloud Platform)" Style="{StaticResource H2}"/>
                            <TextBlock Margin="0,0,0,6">
                                <Run Text="Получить Client ID / Secret: "/>
                                <Hyperlink NavigateUri="https://www.ncloud.com/product/aiService/papago" RequestNavigate="LinkOpener_OnRequestNavigate">ncloud.com (Papago NMT)</Hyperlink>
                            </TextBlock>
                            <TextBlock Text="Client ID" Style="{StaticResource Label}"/>
                            <TextBox x:Name="PapagoIdBox" Margin="0,0,0,6"/>
                            <TextBlock Text="Client Secret" Style="{StaticResource Label}"/>
                            <TextBox x:Name="PapagoSecretBox" Margin="0,0,0,6"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0" Text="Papago поддерживает перевод только между ограниченным набором языков (в основном через корейский/английский/японский/китайский)."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Скорость проверки экрана" Style="{StaticResource H2}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Проверять область каждые" VerticalAlignment="Center"/>
                                <TextBox x:Name="PollingIntervalBox" Width="60" Margin="6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="сек" VerticalAlignment="Center"/>
                            </StackPanel>
                            <CheckBox x:Name="SkipUnchangedCheck">
                                <TextBlock Text="Не распознавать и не переводить повторно, если картинка не изменилась" TextWrapping="Wrap"/>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== ГОРЯЧИЕ КЛАВИШИ ===================== -->
            <TabItem Header="⌨ Горячие клавиши">
                <StackPanel Margin="4,12,4,4">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Настройка сочетаний клавиш" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Кликните по полю и нажмите нужное сочетание клавиш (обязательно с Ctrl, Alt, Shift или Win)."/>

                            <TextBlock Text="Выбрать область экрана" Style="{StaticResource Label}"/>
                            <TextBox x:Name="SelectRegionHotkeyBox" IsReadOnly="True" Margin="0,0,0,12"
                                     PreviewKeyDown="OnHotkeyBoxPreviewKeyDown"/>

                            <TextBlock Text="Включить / выключить перевод" Style="{StaticResource Label}"/>
                            <TextBox x:Name="ToggleHotkeyBox" IsReadOnly="True" Margin="0,0,0,12"
                                     PreviewKeyDown="OnHotkeyBoxPreviewKeyDown"/>

                            <TextBlock Text="Перевести область один раз (не меняя основную область)" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                            <TextBox x:Name="OneTimeHotkeyBox" IsReadOnly="True" Margin="0,0,0,12"
                                     PreviewKeyDown="OnHotkeyBoxPreviewKeyDown"/>

                            <TextBlock Text="Открыть настройки" Style="{StaticResource Label}"/>
                            <TextBox x:Name="OpenSettingsHotkeyBox" IsReadOnly="True"
                                     PreviewKeyDown="OnHotkeyBoxPreviewKeyDown"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ===================== ОФОРМЛЕНИЕ ===================== -->
            <TabItem Header="🎨 Оформление">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,12,4,4">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Расположение и размер" Style="{StaticResource H2}"/>

                            <TextBlock Text="Положение" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="OverlayPositionCombo" Margin="0,0,0,12"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Размер шрифта" VerticalAlignment="Center" Width="140"/>
                                <TextBox x:Name="FontSizeBox" Width="60"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Макс. ширина (px)" VerticalAlignment="Center" Width="140"/>
                                <TextBox x:Name="MaxWidthBox" Width="60"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Цвет и прозрачность" Style="{StaticResource H2}"/>

                            <TextBlock Text="Цвет текста (например #FFFFFF)" Style="{StaticResource Label}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBox x:Name="TextColorBox" Width="120" TextChanged="OnTextColorChanged"/>
                                <Border x:Name="TextColorPreview" Width="26" Height="26" Margin="8,0,0,0" CornerRadius="4"
                                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Cursor="Hand"
                                        ToolTip="Открыть палитру цветов" MouseLeftButtonDown="OnPickTextColorClick"/>
                            </StackPanel>

                            <TextBlock Text="Цвет фона (например #000000)" Style="{StaticResource Label}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBox x:Name="BgColorBox" Width="120" TextChanged="OnBgColorChanged"/>
                                <Border x:Name="BgColorPreview" Width="26" Height="26" Margin="8,0,0,0" CornerRadius="4"
                                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Cursor="Hand"
                                        ToolTip="Открыть палитру цветов" MouseLeftButtonDown="OnPickBgColorClick"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource Label}">
                                <Run Text="Прозрачность фона: "/><Run x:Name="BgOpacityValueText" Text="20%"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4" Text="0% — фон полностью непрозрачный, 100% — полностью прозрачный."/>
                            <Slider x:Name="BgOpacitySlider" Minimum="0" Maximum="100" ValueChanged="OnBgOpacityChanged" Margin="0,0,0,4"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Читаемость текста" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4" Text="Контур и тень — это два разных способа выделить текст на любом фоне; можно выбрать только один."/>
                            <RadioButton x:Name="OutlineNoneRadio" GroupName="OutlineMode" Content="Нет"/>
                            <RadioButton x:Name="OutlineOutlineRadio" GroupName="OutlineMode" Content="Контур"/>
                            <RadioButton x:Name="OutlineShadowRadio" GroupName="OutlineMode" Content="Тень"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Поведение окна" Style="{StaticResource H2}"/>
                            <CheckBox x:Name="ClickThroughCheck" Margin="0,0,0,10">
                                <TextBlock Text="Прозрачное для кликов" TextWrapping="Wrap"/>
                            </CheckBox>

                            <CheckBox x:Name="AutoHideCheck" Checked="OnAutoHideCheckChanged" Unchecked="OnAutoHideCheckChanged">
                                <TextBlock Text="Автоматически скрывать окно перевода, если текст не обновляется" TextWrapping="Wrap"/>
                            </CheckBox>
                            <StackPanel Orientation="Horizontal" Margin="24,6,0,0">
                                <TextBlock Text="Скрывать через" VerticalAlignment="Center"/>
                                <TextBox x:Name="AutoHideSecondsBox" Width="50" Margin="6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="сек" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== ДОПОЛНИТЕЛЬНО ===================== -->
            <TabItem Header="⚙ Дополнительно">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,12,4,4">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Tesseract (для варианта Tesseract)" Style="{StaticResource H2}"/>
                            <TextBlock Margin="0,0,0,6">
                                <Run Text="Скачать файлы языков: "/>
                                <Hyperlink NavigateUri="https://github.com/tesseract-ocr/tessdata_fast" RequestNavigate="LinkOpener_OnRequestNavigate">tessdata_fast на GitHub</Hyperlink>
                            </TextBlock>
                            <TextBlock Text="Папка с файлами языков (.traineddata)" Style="{StaticResource Label}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="TesseractPathBox" Width="420"/>
                                <Button Content="..." Width="36" Margin="6,0,0,0" Style="{StaticResource SecondaryButton}" Click="OnBrowseTesseractFolderClick"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="EasyOCR (для варианта EasyOCR)" Style="{StaticResource H2}"/>
                            <TextBlock Margin="0,0,0,6">
                                <Run Text="Нужен Python: "/>
                                <Hyperlink NavigateUri="https://www.python.org/downloads/" RequestNavigate="LinkOpener_OnRequestNavigate">python.org/downloads</Hyperlink>
                                <Run Text=", затем команда: pip install easyocr"/>
                            </TextBlock>
                            <TextBlock Text="Путь к python.exe" Style="{StaticResource Label}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBox x:Name="EasyOcrPythonBox" Width="420"/>
                                <Button Content="..." Width="36" Margin="6,0,0,0" Style="{StaticResource SecondaryButton}" Click="OnBrowseEasyOcrPythonClick"/>
                            </StackPanel>
                            <CheckBox x:Name="EasyOcrGpuCheck">
                                <TextBlock Text="Использовать видеокарту (нужен PyTorch с поддержкой CUDA)" TextWrapping="Wrap"/>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Запуск" Style="{StaticResource H2}"/>
                            <CheckBox x:Name="RunAtStartupCheck">
                                <TextBlock Text="Запускать KainoTranslator вместе с Windows" TextWrapping="Wrap"/>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Список прокси" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="По одному прокси на строку, например: http://1.2.3.4:8080 или http://логин:пароль@1.2.3.4:8080. Помогает избежать блокировок при частых запросах (в основном для бесплатного Google). Оставьте пустым, если прокси не нужны."/>
                            <TextBox x:Name="ProxyListBox" AcceptsReturn="True" TextWrapping="Wrap" Height="140" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                            <CheckBox x:Name="RotateProxyCheck" Margin="0,8,0,0">
                                <TextBlock Text="Чередовать прокси при каждом запросе (а не использовать только первый)" TextWrapping="Wrap"/>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
