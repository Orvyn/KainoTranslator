<Window x:Class="ScreenTranslator.SettingsUi.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KainoTranslator"
        Width="700" Height="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="16">

        <!-- Header -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <TextBlock Text="🌐" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="KainoTranslator" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource Hint}" Margin="0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                <Button x:Name="SelectRegionButton" Style="{StaticResource IconSquareButton}" Margin="0,0,8,0"
                        Click="OnSelectRegionClick">
                    <TextBlock Text="⛶"/>
                </Button>
                <Button x:Name="ToggleButton" Style="{StaticResource IconSquareButton}"
                        Click="OnToggleClick">
                    <TextBlock x:Name="ToggleButtonIcon" Text="▶"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button x:Name="CloseButton" Width="100" Height="32" Style="{StaticResource SecondaryButton}" Click="OnCloseClick" Margin="0,0,8,0"/>
            <Button x:Name="SaveButton" Width="120" Height="32" Style="{StaticResource PrimaryButton}" Click="OnSaveClick"/>
        </StackPanel>

        <TabControl BorderThickness="0" Background="Transparent">

            <!-- ===================== ПЕРЕВОД (OCR + переводчик объединены) ===================== -->
            <TabItem x:Name="TranslationTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,12,4,4">

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="OcrEngineHeaderText" Style="{StaticResource H2}"/>
                            <ComboBox x:Name="OcrEngineCombo" Margin="0,0,0,4" SelectionChanged="OnOcrEngineChanged"/>
                            <TextBlock x:Name="OcrEngineHint" Style="{StaticResource Hint}"/>
                            <TextBlock x:Name="WindowsOcrLinkBlock">
                                <Hyperlink x:Name="WindowsOcrLink" NavigateUri="ms-settings:regionlanguage" RequestNavigate="LinkOpener_OnRequestNavigate"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="SourceLanguageHeaderText" Style="{StaticResource H2}"/>
                            <ComboBox x:Name="SourceLanguageCombo"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="TargetLanguageHeaderText" Style="{StaticResource H2}"/>
                            <ComboBox x:Name="TargetLanguageCombo"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="TranslatorHeaderText" Style="{StaticResource H2}"/>
                            <ComboBox x:Name="TranslatorCombo" Margin="0,0,0,4" SelectionChanged="OnTranslatorChanged"/>
                            <TextBlock x:Name="TranslatorHint" Style="{StaticResource Hint}"/>
                        </StackPanel>
                    </Border>

                    <!-- DeepL -->
                    <Border x:Name="DeepLCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="DeepLHeaderText" Style="{StaticResource H2}"/>
                            <TextBlock Margin="0,0,0,6">
                                <Run x:Name="DeepLGetKeyRun"/>
                                <Hyperlink NavigateUri="https://www.deepl.com/pro-api" RequestNavigate="LinkOpener_OnRequestNavigate">deepl.com/pro-api</Hyperlink>
                            </TextBlock>
                            <TextBlock x:Name="DeepLApiKeyLabel" Style="{StaticResource Label}"/>
                            <TextBox x:Name="DeepLKeyBox" Margin="0,0,0,6"/>
                            <CheckBox x:Name="DeepLProCheck">
                                <TextBlock x:Name="DeepLProText" TextWrapping="Wrap"/>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Google -->
                    <Border x:Name="GoogleCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="GoogleHeaderText" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="GoogleHintText" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                            <TextBlock Margin="0,0,0,6">
                                <Hyperlink x:Name="GoogleGetKeyLink" NavigateUri="https://cloud.google.com/translate/docs/setup" RequestNavigate="LinkOpener_OnRequestNavigate"/>
                            </TextBlock>
                            <TextBlock x:Name="GoogleApiKeyLabel" Style="{StaticResource Label}"/>
                            <TextBox x:Name="GoogleKeyBox"/>
                        </StackPanel>
                    </Border>

                    <!-- Yandex -->
                    <Border x:Name="YandexCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="YandexHeaderText" Style="{StaticResource H2}"/>
                            <TextBlock Margin="0,0,0,6">
                                <Run x:Name="YandexGetKeyRun"/>
                                <Hyperlink NavigateUri="https://yandex.cloud/en/docs/translate/quickstart" RequestNavigate="LinkOpener_OnRequestNavigate">yandex.cloud (Translate quickstart)</Hyperlink>
                            </TextBlock>
                            <TextBlock x:Name="YandexApiKeyLabel" Style="{StaticResource Label}"/>
                            <TextBox x:Name="YandexKeyBox" Margin="0,0,0,6"/>
                            <TextBlock x:Name="YandexFolderIdLabel" Style="{StaticResource Label}"/>
                            <TextBox x:Name="YandexFolderBox"/>
                        </StackPanel>
                    </Border>

                    <!-- Papago -->
                    <Border x:Name="PapagoCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="PapagoHeaderText" Style="{StaticResource H2}"/>
                            <TextBlock Margin="0,0,0,6">
                                <Run x:Name="PapagoGetKeyRun"/>
                                <Hyperlink NavigateUri="https://www.ncloud.com/product/aiService/papago" RequestNavigate="LinkOpener_OnRequestNavigate">ncloud.com (Papago NMT)</Hyperlink>
                            </TextBlock>
                            <TextBlock x:Name="PapagoClientIdLabel" Style="{StaticResource Label}"/>
                            <TextBox x:Name="PapagoIdBox" Margin="0,0,0,6"/>
                            <TextBlock x:Name="PapagoClientSecretLabel" Style="{StaticResource Label}"/>
                            <TextBox x:Name="PapagoSecretBox" Margin="0,0,0,6"/>
                            <TextBlock x:Name="PapagoHintText" Style="{StaticResource Hint}" Margin="0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="PollingHeaderText" Style="{StaticResource H2}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock x:Name="PollingPrefixText" VerticalAlignment="Center"/>
                                <TextBox x:Name="PollingIntervalBox" Width="60" Margin="6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SecondsText1" VerticalAlignment="Center"/>
                            </StackPanel>
                            <CheckBox x:Name="SkipUnchangedCheck">
                                <TextBlock x:Name="SkipUnchangedText" TextWrapping="Wrap"/>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="BehaviorHeaderText" Style="{StaticResource H2}"/>
                            <CheckBox x:Name="AutoStartAfterRegionSelectCheck">
                                <TextBlock x:Name="AutoStartText" TextWrapping="Wrap"/>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== ГОРЯЧИЕ КЛАВИШИ ===================== -->
            <TabItem x:Name="HotkeysTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,12,4,4">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="HotkeysHeaderText" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="HotkeysHintText" Style="{StaticResource Hint}"/>

                            <TextBlock x:Name="HotkeySelectRegionLabel" Style="{StaticResource Label}"/>
                            <TextBox x:Name="SelectRegionHotkeyBox" IsReadOnly="True" Margin="0,0,0,12"
                                     PreviewKeyDown="OnHotkeyBoxPreviewKeyDown"/>

                            <TextBlock x:Name="HotkeyToggleLabel" Style="{StaticResource Label}"/>
                            <TextBox x:Name="ToggleHotkeyBox" IsReadOnly="True" Margin="0,0,0,12"
                                     PreviewKeyDown="OnHotkeyBoxPreviewKeyDown"/>

                            <TextBlock x:Name="HotkeyOnceLabel" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                            <TextBox x:Name="OneTimeHotkeyBox" IsReadOnly="True" Margin="0,0,0,12"
                                     PreviewKeyDown="OnHotkeyBoxPreviewKeyDown"/>

                            <TextBlock x:Name="HotkeyRetranslateLabel" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                            <TextBox x:Name="RetranslateHotkeyBox" IsReadOnly="True" Margin="0,0,0,12"
                                     PreviewKeyDown="OnHotkeyBoxPreviewKeyDown"/>

                            <TextBlock x:Name="HotkeyOpenSettingsLabel" Style="{StaticResource Label}"/>
                            <TextBox x:Name="OpenSettingsHotkeyBox" IsReadOnly="True"
                                     PreviewKeyDown="OnHotkeyBoxPreviewKeyDown"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="HoverSectionHeaderText" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="HoverSectionHintText" Style="{StaticResource Hint}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton x:Name="HoverModeOffRadio" GroupName="HoverMode"
                                             Margin="0,3,20,3" VerticalAlignment="Center"
                                             Checked="OnHoverModeChanged"/>
                                <RadioButton x:Name="HoverModeImmediateRadio" GroupName="HoverMode"
                                             Margin="0,3,20,3" VerticalAlignment="Center"
                                             Checked="OnHoverModeChanged"/>
                                <RadioButton x:Name="HoverModeConfirmRadio" GroupName="HoverMode"
                                             Margin="0,3,0,3" VerticalAlignment="Center"
                                             Checked="OnHoverModeChanged"/>
                            </StackPanel>

                            <TextBox x:Name="HoverTriggerKeyBox" IsReadOnly="True"
                                     PreviewKeyDown="OnHoverTriggerKeyBoxPreviewKeyDown"
                                     PreviewMouseDown="OnHoverTriggerKeyBoxPreviewMouseDown"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== ОФОРМЛЕНИЕ ===================== -->
            <TabItem x:Name="AppearanceTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,12,4,4">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="PositionSizeHeaderText" Style="{StaticResource H2}"/>

                            <TextBlock x:Name="PositionLabel" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="OverlayPositionCombo" Margin="0,0,0,12"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock x:Name="FontSizeLabel" VerticalAlignment="Center" Width="140"/>
                                <TextBox x:Name="FontSizeBox" Width="60"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock x:Name="MaxWidthLabel" VerticalAlignment="Center" Width="140"/>
                                <TextBox x:Name="MaxWidthBox" Width="60"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="ColorHeaderText" Style="{StaticResource H2}"/>

                            <TextBlock x:Name="TextColorLabel" Style="{StaticResource Label}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBox x:Name="TextColorBox" Width="120" TextChanged="OnTextColorChanged"/>
                                <Border x:Name="TextColorPreview" Width="26" Height="26" Margin="8,0,0,0" CornerRadius="4"
                                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Cursor="Hand"
                                        MouseLeftButtonDown="OnPickTextColorClick"/>
                            </StackPanel>

                            <TextBlock x:Name="BgColorLabel" Style="{StaticResource Label}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBox x:Name="BgColorBox" Width="120" TextChanged="OnBgColorChanged"/>
                                <Border x:Name="BgColorPreview" Width="26" Height="26" Margin="8,0,0,0" CornerRadius="4"
                                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Cursor="Hand"
                                        MouseLeftButtonDown="OnPickBgColorClick"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource Label}">
                                <Run x:Name="BgOpacityLabelRun"/><Run x:Name="BgOpacityValueText" Text="20%"/>
                            </TextBlock>
                            <TextBlock x:Name="BgOpacityHintText" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                            <Slider x:Name="BgOpacitySlider" Minimum="0" Maximum="100" ValueChanged="OnBgOpacityChanged" Margin="0,0,0,4"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="ReadabilityHeaderText" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="ReadabilityHintText" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                            <RadioButton x:Name="OutlineNoneRadio" GroupName="OutlineMode"/>
                            <RadioButton x:Name="OutlineOutlineRadio" GroupName="OutlineMode"/>
                            <RadioButton x:Name="OutlineShadowRadio" GroupName="OutlineMode"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="WindowBehaviorHeaderText" Style="{StaticResource H2}"/>
                            <CheckBox x:Name="ClickThroughCheck" Margin="0,0,0,10">
                                <TextBlock x:Name="ClickThroughText" TextWrapping="Wrap"/>
                            </CheckBox>

                            <CheckBox x:Name="AutoHideCheck" Checked="OnAutoHideCheckChanged" Unchecked="OnAutoHideCheckChanged">
                                <TextBlock x:Name="AutoHideText" TextWrapping="Wrap"/>
                            </CheckBox>
                            <StackPanel Orientation="Horizontal" Margin="24,6,0,0">
                                <TextBlock x:Name="AutoHidePrefixText" VerticalAlignment="Center"/>
                                <TextBox x:Name="AutoHideSecondsBox" Width="50" Margin="6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SecondsText2" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== ГЛОССАРИЙ ===================== -->
            <TabItem x:Name="GlossaryTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,12,4,4">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="GlossaryHeaderText" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="GlossaryHintText" Style="{StaticResource Hint}"/>

                            <Grid Margin="0,8,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="GlossaryProfileNameBox" Grid.Column="0" Margin="0,0,6,0"
                                         VerticalAlignment="Center" TextChanged="OnGlossaryProfileNameChanged"/>
                                <Button x:Name="GlossaryProfileSwitchButton" Grid.Column="1" Content="▾" Style="{StaticResource SecondaryButton}"
                                        Padding="10,6" Margin="0,0,6,0" Click="OnGlossaryProfileSwitchClick"/>
                                <Button x:Name="AddGlossaryProfileButton" Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                        Padding="10,6" Margin="0,0,6,0" Click="OnAddGlossaryProfileClick"/>
                                <Button x:Name="DeleteGlossaryProfileButton" Grid.Column="3" Style="{StaticResource SecondaryButton}"
                                        Padding="10,6" Click="OnDeleteGlossaryProfileClick"/>
                            </Grid>

                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="GlossarySourceColumnLabel" Grid.Column="0" Style="{StaticResource Hint}" Margin="0,0,6,4"/>
                                <TextBlock x:Name="GlossaryTargetColumnLabel" Grid.Column="1" Style="{StaticResource Hint}" Margin="0,0,6,4"/>
                            </Grid>

                            <ItemsControl x:Name="GlossaryItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding SourceTerm, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding TargetTerm, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                                            <Button Grid.Column="2" Content="✕" Style="{StaticResource SecondaryButton}" Padding="0" Click="OnRemoveGlossaryEntryClick"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button x:Name="AddGlossaryEntryButton" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                    Padding="14,6" Margin="0,4,0,0" Click="OnAddGlossaryEntryClick"/>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="ExportGlossaryButton" Style="{StaticResource SecondaryButton}"
                                        Padding="14,6" Margin="0,0,8,0" Click="OnExportGlossaryClick"/>
                                <Button x:Name="ImportGlossaryButton" Style="{StaticResource SecondaryButton}"
                                        Padding="14,6" Click="OnImportGlossaryClick"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== ПРОЧЕЕ ===================== -->
            <TabItem x:Name="OtherTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,12,4,4">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="LanguageHeaderText" Style="{StaticResource H2}"/>
                            <ComboBox x:Name="UiLanguageCombo" Margin="0,0,0,4"/>
                            <TextBlock x:Name="LanguageHintText" Style="{StaticResource Hint}" Margin="0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="TesseractHeaderText" Style="{StaticResource H2}"/>
                            <TextBlock Margin="0,0,0,6">
                                <Run x:Name="TesseractGetFilesRun"/>
                                <Hyperlink NavigateUri="https://github.com/tesseract-ocr/tessdata_fast" RequestNavigate="LinkOpener_OnRequestNavigate">tessdata_fast on GitHub</Hyperlink>
                            </TextBlock>
                            <TextBlock x:Name="TesseractFolderLabel" Style="{StaticResource Label}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="TesseractPathBox" Width="420"/>
                                <Button Content="..." Width="36" Margin="6,0,0,0" Style="{StaticResource SecondaryButton}" Click="OnBrowseTesseractFolderClick"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="EasyOcrHeaderText" Style="{StaticResource H2}"/>
                            <TextBlock Margin="0,0,0,6">
                                <Run x:Name="EasyOcrNeedPythonRun"/>
                                <Hyperlink NavigateUri="https://www.python.org/downloads/" RequestNavigate="LinkOpener_OnRequestNavigate">python.org/downloads</Hyperlink>
                                <Run x:Name="EasyOcrThenRunRun"/>
                            </TextBlock>
                            <TextBlock x:Name="EasyOcrPathLabel" Style="{StaticResource Label}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBox x:Name="EasyOcrPythonBox" Width="420"/>
                                <Button Content="..." Width="36" Margin="6,0,0,0" Style="{StaticResource SecondaryButton}" Click="OnBrowseEasyOcrPythonClick"/>
                            </StackPanel>
                            <CheckBox x:Name="EasyOcrGpuCheck">
                                <TextBlock x:Name="EasyOcrGpuText" TextWrapping="Wrap"/>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="StartupHeaderText" Style="{StaticResource H2}"/>
                            <CheckBox x:Name="RunAtStartupCheck">
                                <TextBlock x:Name="RunAtStartupText" TextWrapping="Wrap"/>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="ProxyHeaderText" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="ProxyHintText" Style="{StaticResource Hint}"/>
                            <TextBox x:Name="ProxyListBox" AcceptsReturn="True" TextWrapping="Wrap" Height="140" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                            <CheckBox x:Name="RotateProxyCheck" Margin="0,8,0,0">
                                <TextBlock x:Name="RotateProxyText" TextWrapping="Wrap"/>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
