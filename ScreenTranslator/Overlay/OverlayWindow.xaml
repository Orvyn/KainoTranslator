<Window x:Class="ScreenTranslator.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KainoTranslator - Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowActivated="False"
        SizeToContent="WidthAndHeight">
    <Border x:Name="Backdrop"
            CornerRadius="10"
            Background="#CC000000"
            Padding="16,10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.55" Color="Black"/>
        </Border.Effect>

        <Grid x:Name="TextGrid">
            <!-- 8 offset copies behind the main text simulate a ~1px outline (WPF's TextBlock
                 has no native text-stroke, so this is the standard trick for it). Only shown
                 when OutlineMode = Outline. -->
            <TextBlock x:Name="Outline_NW" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center">
                <TextBlock.RenderTransform><TranslateTransform X="-1" Y="-1"/></TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock x:Name="Outline_N" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center">
                <TextBlock.RenderTransform><TranslateTransform X="0" Y="-1"/></TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock x:Name="Outline_NE" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center">
                <TextBlock.RenderTransform><TranslateTransform X="1" Y="-1"/></TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock x:Name="Outline_W" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center">
                <TextBlock.RenderTransform><TranslateTransform X="-1" Y="0"/></TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock x:Name="Outline_E" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center">
                <TextBlock.RenderTransform><TranslateTransform X="1" Y="0"/></TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock x:Name="Outline_SW" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center">
                <TextBlock.RenderTransform><TranslateTransform X="-1" Y="1"/></TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock x:Name="Outline_S" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center">
                <TextBlock.RenderTransform><TranslateTransform X="0" Y="1"/></TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock x:Name="Outline_SE" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center">
                <TextBlock.RenderTransform><TranslateTransform X="1" Y="1"/></TextBlock.RenderTransform>
            </TextBlock>

            <TextBlock x:Name="TranslatedText"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>
        </Grid>
    </Border>
</Window>
