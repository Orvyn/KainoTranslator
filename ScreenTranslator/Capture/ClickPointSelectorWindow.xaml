<Window x:Class="ScreenTranslator.Capture.ClickPointSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KainoTranslator"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Cursor="Cross"
        WindowStartupLocation="Manual">
    <Grid>
        <Canvas x:Name="RootCanvas" Background="Transparent">
            <TextBlock x:Name="HintText"
                       Foreground="White" FontSize="18" FontFamily="Segoe UI"
                       Canvas.Left="20" Canvas.Top="20"
                       Background="#AA000000" Padding="10,6"/>
        </Canvas>
    </Grid>
</Window>
