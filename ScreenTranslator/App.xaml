<Application x:Class="ScreenTranslator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Controls.xaml only - no palette here. ThemeManager (see App.xaml.cs) merges
                     Palette.Light.xaml or Palette.Dark.xaml on startup, based on settings/the
                     Windows theme, and swaps it at runtime when either changes; every color in
                     Controls.xaml is a DynamicResource so it picks that swap up live. -->
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
