<Window x:Class="ScreenTranslator.Onboarding.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KainoTranslator"
        Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True">
    <StackPanel Margin="24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="🌐" FontSize="28" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Text="KainoTranslator" Style="{StaticResource H1}" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="SubtitleText"
                   Style="{StaticResource Hint}" Margin="0,0,0,16" FontSize="13"/>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock x:Name="TrayHeaderText" Style="{StaticResource H2}"/>
                <TextBlock x:Name="TrayBodyText" TextWrapping="Wrap" Style="{StaticResource Label}" Margin="0,0,0,0"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock x:Name="HotkeysHeaderText" Style="{StaticResource H2}"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="HotkeySelectRegionLabel" Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,10,6"/>
                    <TextBlock x:Name="HotkeyRegion" Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center"/>

                    <TextBlock x:Name="HotkeyToggleLabel" Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,10,6"/>
                    <TextBlock x:Name="HotkeyToggle" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center"/>

                    <TextBlock x:Name="HotkeyOnceLabel" Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,10,6"/>
                    <TextBlock x:Name="HotkeyOnce" Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center"/>

                    <TextBlock x:Name="HotkeyOpenSettingsLabel" Grid.Row="3" Grid.Column="0" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,10,0"/>
                    <TextBlock x:Name="HotkeyOpenSettings" Grid.Row="3" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="HotkeysFooterText" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock x:Name="GameTipHeaderText" Style="{StaticResource H2}"/>
                <TextBlock x:Name="GameTipBodyText" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock x:Name="DefaultsHeaderText" Style="{StaticResource H2}"/>
                <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0">
                    <Run x:Name="DefaultsBody1Run"/><Run x:Name="DefaultsBody1BoldRun" FontWeight="SemiBold"/><Run x:Name="DefaultsBody2Run"/><Run x:Name="DefaultsBody2BoldRun" FontWeight="SemiBold"/><Run x:Name="DefaultsBody3Run"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <CheckBox x:Name="DontShowAgainCheck" Margin="0,4,0,14">
            <TextBlock x:Name="DontShowAgainText" TextWrapping="Wrap"/>
        </CheckBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CloseButton" Style="{StaticResource SecondaryButton}" Width="110" Height="34" Margin="0,0,8,0" Click="OnCloseClick"/>
            <Button x:Name="OpenSettingsButton" Style="{StaticResource PrimaryButton}" Width="170" Height="34" Click="OnOpenSettingsClick"/>
        </StackPanel>
    </StackPanel>
</Window>
