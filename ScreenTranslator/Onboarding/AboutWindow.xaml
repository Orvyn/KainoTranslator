<Window x:Class="ScreenTranslator.Onboarding.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе — KainoTranslator"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <StackPanel Margin="24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="🌐" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Text="KainoTranslator" Style="{StaticResource H1}" VerticalAlignment="Center"/>
            <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
        </StackPanel>
        <TextBlock Text="Перевод текста с экрана в реальном времени — для игр, субтитров и других приложений."
                   Style="{StaticResource Hint}" Margin="0,0,0,16" FontSize="13"/>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,6">
                    <Run Text="Распознавание текста:" FontWeight="SemiBold"/> Windows OCR, Tesseract, EasyOCR
                </TextBlock>
                <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0">
                    <Run Text="Перевод:" FontWeight="SemiBold"/> DeepL, Google Translate, Yandex Translate, Papago
                </TextBlock>
            </StackPanel>
        </Border>

        <TextBlock Margin="0,4,0,4">
            <Hyperlink NavigateUri="https://github.com/Orvyn/KainoTranslator" RequestNavigate="OnRequestNavigate">github.com/Orvyn/KainoTranslator</Hyperlink>
        </TextBlock>

        <TextBlock Text="© 2026" Style="{StaticResource Hint}" Margin="0,4,0,16"/>

        <Button Content="Закрыть" Style="{StaticResource SecondaryButton}" Width="110" Height="34" HorizontalAlignment="Right" Click="OnCloseClick"/>
    </StackPanel>
</Window>
